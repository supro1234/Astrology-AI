# ── VedAstro App Environment Configuration Template ──────────────────
# NOTE: This file is public and tracked by Git. NEVER put real keys or passwords here.
# Copy this file to .env and fill in your actual private credentials.

# 1.  Astrology API (COMPULSORY)
# Required to calculate charts, planetary positions, panchang, kundali & horoscopes.
# Obtain your Access Token from: https://astrologyapi.com
VITE_ASTRO_API_KEY=your_astrology_api_access_token_here
VITE_ASTRO_USER_ID=your_astrology_api_user_id_here

# 2.  OpenRouter AI API (Required for AI chat & cosmic insights)
# Obtain your API key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (defaults to openrouter/free for 100% free auto-routing)
VITE_OPENROUTER_MODEL=openrouter/free
# optional 
VITE_SENTRY_DSN=
VITE_APP_VERSION=2.0.5
